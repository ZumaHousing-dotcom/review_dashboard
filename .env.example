# Google Business Profile (OAuth refresh token for a user who manages the profile)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_LOCATION=accounts/ACCOUNT_ID/locations/LOCATION_ID
# Yelp Fusion
YELP_API_KEY=
YELP_BUSINESS_ID=
# AppFolio: either a CSV export path, or an authenticated report URL
APPFOLIO_CSV=
APPFOLIO_URL=
APPFOLIO_TOKEN=
APPFOLIO_COOKIE=
# Google via SerpApi (easiest; no Google approval). If SERPAPI_KEY is set it is used instead of the GOOGLE_* values above.
SERPAPI_KEY=
SERPAPI_PLACE_ID=ChIJcTynjYG8woARQfVrh25QzU4
SERPAPI_DATA_ID=
# AppFolio survey data stored in Supabase (used instead of the CSV if SUPABASE_URL is set)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=maintenance_survey_2026,move_in_survey_2026,move_out_survey_2026,showings_survey_2026
# Yelp via SerpApi: the end of your Yelp page address, e.g. zuma-housing-los-angeles-2
# (with SERPAPI_KEY set, YELP_API_KEY is not needed)
